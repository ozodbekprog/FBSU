  degree        String   @default("BAKALAVR")
  educationForm String   @default("KUNDUZGI")
  quota         Int      @default(25)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  applications AdmissionApplication[]

  @@index([isActive])
}

model AdmissionApplication {
  id             String          @id @default(cuid())
  programId      String
  applicantName  String
  phone          String
  email          String?
  passport       String?
  school         String?
  note           String?
  status         AdmissionStatus @default(NEW)
  examScore1     Int?
  examScore2     Int?
  interviewScore Int?
  decisionNote   String?
  studentId      String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  program AdmissionProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  student User?            @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([programId])
}

/// Ilmiy ish turi.
enum PublicationKind {
  ARTICLE
  CONFERENCE
  MONOGRAPH
  PATENT
  TEXTBOOK
}

enum PublicationStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
}

enum PublicationIndexing {
  NONE
  SCOPUS
  WOS
  RINC
  LOCAL
}

/// O'qituvchining ilmiy ishi — maqola, konferensiya,
/// monografiya, patent yoki darslik.
model Publication {
  id        String              @id @default(cuid())
  userId    String
  title     String
  kind      PublicationKind     @default(ARTICLE)
  status    PublicationStatus   @default(DRAFT)
  indexing  PublicationIndexing @default(NONE)
  authors   String?
  journal   String?
  year      Int?
  doi       String?
  url       String?
  note      String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([year])
  @@index([kind])
}

enum GradeItemSource {
  MANUAL
  ASSIGNMENT
  QUIZ
}

model GradeCategory {
  id       String @id @default(cuid())
  courseId String
  name     String
  weight   Int
  position Int    @default(0)

  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items  GradeItem[]

  @@index([courseId])
}

model GradeItem {
  id         String          @id @default(cuid())
  courseId   String
  categoryId String?
  name       String
  weight     Int             @default(0)
  maxScore   Float           @default(100)
  source     GradeItemSource @default(MANUAL)
  refId      String?

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category GradeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  scores   GradeItemScore[]
  history  GradeItemScoreHistory[]

  @@index([courseId])
  @@index([categoryId])
}

model GradeItemScore {
  id        String   @id @default(cuid())
  itemId    String
  studentId String
  score     Float
  updatedAt DateTime @updatedAt

  item    GradeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  student User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([itemId, studentId])
  @@index([studentId])
}

enum ActivityTarget {
  MATERIAL
  ASSIGNMENT
  QUIZ
}

model ActivityRule {
  id            String         @id @default(cuid())
  courseId      String
  targetType    ActivityTarget
  targetId      String
  availableFrom DateTime?
  availableTo   DateTime?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId])
  @@index([courseId])
}

model ActivityCompletion {
  id          String         @id @default(cuid())
  studentId   String
  targetType  ActivityTarget
  targetId    String
  completedAt DateTime       @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, targetType, targetId])
  @@index([targetId])
}

model OwnerAccessCode {
  id         String    @id @default(cuid())
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

model AssignmentExtension {
  id            String   @id @default(cuid())
  assignmentId  String
  studentId     String
  extendedDueAt DateTime
  createdAt     DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
}


model GradeItemScoreHistory {
  id          String   @id @default(cuid())
  itemId      String
  studentId   String
  oldScore    Float?
  newScore    Float?
  changedById String?
  createdAt   DateTime @default(now())

  item    GradeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  student User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([itemId, studentId])
  @@index([createdAt])
}


model ChoicePoll {
  id         String   @id @default(cuid())
  courseId   String
  question   String
  options    Json     @default("[]")
  isMultiple Boolean  @default(false)
  isAnonymous Boolean @default(false)
  createdAt  DateTime @default(now())

  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  votes  ChoiceVote[]

  @@index([courseId])
}

model ChoiceVote {
  id          String   @id @default(cuid())
  pollId      String
  studentId   String
  optionIndex Int
  createdAt   DateTime @default(now())

  poll    ChoicePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  student User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([pollId, studentId, optionIndex])
  @@index([pollId])
}

model GlossaryEntry {
  id          String   @id @default(cuid())
  courseId    String
  term        String
  definition  String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("GlossaryAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([term])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model Cohort {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  members CohortMember[]
}

model CohortMember {
  id        String   @id @default(cuid())
  cohortId  String
  userId    String
  createdAt DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@index([userId])
}
