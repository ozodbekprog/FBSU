generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  REKTOR
  PRO_RECTOR
  DEKAN
  KAFEDRA_MUDIRI
  REGISTRAR
  BUXGALTER
  TYUTOR
  TEACHER
  STUDENT
  XODIM
  OTA_ONA
  NAZORATCHI
}

/// Oylik to'lovining bosqichlar.
/// `DRAFT` — buxgalter kiritayotgan, hech kimga ko'rinmaydi.
/// `PENDING` — ko'rib chiqishga yuborilgan.
/// `APPROVED` — tasdiqlangan, to'lovga tayyor.
/// `PAID` — to'langan.
enum SalaryStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
}

enum MaterialType {
  TEXT
  FILE
  VIDEO
  LINK
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  LATE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  SUSPICIOUS
  LEFT_EARLY
}

enum AttendanceSessionKind {
  CHECK_IN
  CHECK_OUT
}

enum BugStatus {
  NEW
  IN_REVIEW
  FIXED
  REJECTED
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TEXT
  TRUE_FALSE
  SHORT_ANSWER
  NUMERIC
  MATCHING
  ORDERING
  CLOZE
  ESSAY
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           Role      @default(STUDENT)
  avatarUrl      String?
  coverUrl       String?
  bio            String?
  preferences    Json?
  isActive       Boolean   @default(true)
  sessionEpoch   Int       @default(0)
  /// Oxirgi faol vaqt — suhbat sarlavhasida "M10 6, 17:00 da onlayn bo'lg"
  /// ko'rinishi uchun.
  lastSeenAt     DateTime?
  faceDescriptor Json?
  faceEnrolledAt DateTime?
  createdAt      DateTime  @default(now())

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  taughtCourses        Course[]              @relation("CourseLeadTeacher")
  courseTeaching       CourseTeacher[]
  enrollments          Enrollment[]
  studyPlans      StudyPlan[]
  submissions          Submission[]
  attendance           Attendance[]
  staffAttendance      StaffAttendance[]
  accessLogs           AccessLog[]
  documentsCreated     Document[]            @relation("DocumentCreator")
  documentsToSign      Document[]            @relation("DocumentSigner")
  documentsSigned      Document[]            @relation("DocumentSignedBy")
  admissionApplication AdmissionApplication?
  parentLinksAsParent  ParentLink[]          @relation("ParentLinkParent")
  parentLinksAsStudent ParentLink[]          @relation("ParentLinkStudent")
  contracts            Contract[]
  payments             Payment[]
  paymentsCreated      Payment[]             @relation("PaymentCreatedBy")
  diplomas             Diploma[]
  tasksAssigned        WorkTask[]            @relation("WorkTaskAssignee")
  tasksCreated         WorkTask[]            @relation("WorkTaskCreator")
  quizAttempts         QuizAttempt[]
  secureExamsCreated   SecureExam[]          @relation("SecureExamCreator")
  secureExamRuns       SecureExamRun[]       @relation("SecureExamStudent")
  notifications        Notification[]

  announcements        Announcement[]
  forumTopics          ForumTopic[]
  forumReplies         ForumReply[]
  certificatesIssued   Certificate[]  @relation("CertificateIssuedBy")
  certificatesReceived Certificate[]  @relation("CertificateStudent")
  bonusPointsReceived  BonusPoint[]   @relation("BonusPointStudent")
  bonusPointsAwarded   BonusPoint[]   @relation("BonusPointAwardedBy")
  teacherPointsReceived TeacherPoint[]   @relation("TeacherPointStudent")
  teacherPointsAwarded   TeacherPoint[]   @relation("TeacherPointAwardedBy")
  attendancePointConfigs AttendancePointConfig[]

  // Oylik moduli: lavozim, haftalik navbar va oylik yozuvlari
  staffPositionId       String?
  staffPosition         StaffPosition?         @relation(fields: [staffPositionId], references: [id], onDelete: SetNull)
  shiftAssignments      StaffShiftAssignment[]
  salaryRecords         SalaryRecord[]         @relation("SalaryRecordUser")
  salaryCreated         SalaryRecord[]         @relation("SalaryRecordCreatedBy")
  salaryReviewed        SalaryRecord[]         @relation("SalaryRecordReviewedBy")
  salaryGrants          SalaryGrant[]          @relation("SalaryGrantGrantedBy")
  gradeChangeRequests   GradeChangeRequest[]   @relation("GradeChangeRequester")
  gradeChangeReviews    GradeChangeRequest[]   @relation("GradeChangeReviewer")
  oralDefenses          OralDefense[]          @relation("OralDefenseStudent")
  oralDefenseRequests   OralDefense[]          @relation("OralDefenseRequester")
  boards                Board[]
  departmentId          String?
  department            Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attendanceSessions    AttendanceSession[]
  conversationsA        Conversation[]         @relation("ConversationA")
  conversationsB        Conversation[]         @relation("ConversationB")
  messagesSent          Message[]              @relation("MessageSender")
  callsMade             CallSession[]          @relation("CallCaller")
  callsReceived         CallSession[]          @relation("CallCallee")
  chatSettings          ConversationSetting[]
  blocksGiven           ChatBlock[]            @relation("ChatBlocker")
  blocksReceived        ChatBlock[]            @relation("ChatBlocked")
  reportsGiven          UserReport[]           @relation("ReportReporter")
  reportsReceived       UserReport[]           @relation("ReportReported")
  roomBookings          RoomBooking[]
  orders                Order[]
  courseReviews         CourseReview[]
  subjectsTaught        TeacherSubject[]
  scheduleEntriesTaught ScheduleEntry[]        @relation("ScheduleTeacher")
  examSheets            ExamSheet[]
  verifiedSessions ExamSession[] @relation("SheetVerifier")
  auditLogs             AuditLog[]
  passwordResets        PasswordResetToken[]
  bugReports            BugReport[]
  publications          Publication[]

  subGroupId    String?
  subGroup      SubGroup? @relation(fields: [subGroupId], references: [id], onDelete: SetNull)
  facultyId     String?
  faculty       Faculty?  @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  curatedGroups Group[]   @relation("GroupCurator")

  @@index([groupId])
  gradeItemScores    GradeItemScore[]
  activityCompletions ActivityCompletion[]
  assignmentExtensions AssignmentExtension[]
  gradeItemHistory   GradeItemScoreHistory[]
  choiceVotes        ChoiceVote[]
  cohortMemberships  CohortMember[]
  glossaryEntries    GlossaryEntry[] @relation("GlossaryAuthor")
  apiTokens          ApiToken[]

  @@index([subGroupId])
  @@index([role])
  @@index([facultyId])
  @@index([departmentId])
}

model Group {
  id        String          @id @default(cuid())
  name      String          @unique
  /// EduPage (ttp u.edupage.org) sinf nomi — avto jadval sinxronizatsiyasi uchun.
  /// Bo'sh bo'lsa `name` bilan solishtiriladi.
  edupageName String?
  year      Int?
  facultyId String?
  faculty   Faculty?        @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  curatorId String?
  curator   User?           @relation("GroupCurator", fields: [curatorId], references: [id], onDelete: SetNull)
  users     User[]
  schedule  ScheduleEntry[]
  subGroups SubGroup[]
  studyPlans StudyPlan[]
  attendancePointConfigs AttendancePointConfig[]

  @@index([curatorId])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  coverColor  String   @default("#2563eb")
  isPublished Boolean  @default(false)
  isElective  Boolean  @default(false)
  subjectId   String?
  createdAt   DateTime @default(now())

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  teacherId String
  teacher   User   @relation("CourseLeadTeacher", fields: [teacherId], references: [id])
  teacherIds   String[] @default([])
  managerIds   String[] @default([])
  assistantIds String[] @default([])
  teachers     CourseTeacher[]

  sections    Section[]
  assignments Assignment[]
  quizzes     Quiz[]
  enrollments Enrollment[]
  attendance  Attendance[]

  announcements      Announcement[]
  forumTopics        ForumTopic[]
  certificates       Certificate[]
  attendanceSessions AttendanceSession[]
  reviews            CourseReview[]
  examSessions       ExamSession[]
  secureExams        SecureExam[]
  bankQuestions      BankQuestion[]
  selfEnrollment     Boolean             @default(false)
  bonusPoints        BonusPoint[]
  teacherPoints      TeacherPoint[]
  attendancePointConfigs AttendancePointConfig[]
  studyPlans         StudyPlan[]
  gradeCategories    GradeCategory[]
  gradeItems         GradeItem[]
  activityRules      ActivityRule[]
  choicePolls        ChoicePoll[]
  glossaryEntries    GlossaryEntry[]

  @@index([teacherId])
  @@index([teacherIds], type: Gin)
  @@index([managerIds], type: Gin)
  @@index([assistantIds], type: Gin)
}

enum CourseTeacherRole {
  LEAD
  CO_TEACHER
  ASSISTANT
  OBSERVER
}

model CourseTeacher {
  id        String            @id @default(cuid())
  courseId  String
  userId    String
  role      CourseTeacherRole @default(CO_TEACHER)
  createdAt DateTime          @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
}

model Enrollment {
  id        String           @id @default(cuid())
  courseId  String
  userId    String
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([status])
  @@index([userId])
}

model Section {
  id       String @id @default(cuid())
  courseId String
  title    String
  position Int    @default(0)

  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials   Material[]
  assignments Assignment[]
  entries     ScheduleEntry[]
}

model Material {
  id        String       @id @default(cuid())
  sectionId String
  title     String
  type      MaterialType @default(TEXT)
  content   String?
  fileUrl   String?
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String    @id @default(cuid())
  courseId    String
  sectionId   String?
  title       String
  description String?
  dueAt       DateTime?
  maxScore    Int       @default(100)
  createdAt   DateTime  @default(now())

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionRef   Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  submissions  Submission[]
  extensions   AssignmentExtension[]
  oralDefenses OralDefense[]
  boards       Board[]

  @@index([sectionId])
}

model Board {
  id           String   @id @default(cuid())
  userId       String
  assignmentId String?
  data         Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assignmentId])
}

enum OralDefenseStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  DONE
  CANCELLED
}

enum OralDefenseResult {
  PASSED
  FAILED
}

model OralDefense {
  id            String             @id @default(cuid())
  assignmentId  String
  studentId     String
  requestedById String
  status        OralDefenseStatus  @default(REQUESTED)
  note          String?
  scheduledAt   DateTime?
  result        OralDefenseResult?
  resultNote    String?
  createdAt     DateTime           @default(now())
  decidedAt     DateTime?

  assignment  Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student     User       @relation("OralDefenseStudent", fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("OralDefenseRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  text         String?
  fileUrl      String?
  submittedAt  DateTime         @default(now())
  status       SubmissionStatus @default(SUBMITTED)
  score        Int?
  feedback     String?
  gradedAt     DateTime?

  assignment   Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradeChanges GradeChangeRequest[]

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([submittedAt])
}

model GradeChangeRequest {
  id            String            @id @default(cuid())
  submissionId  String
  requestedById String
  oldScore      Int?
  newScore      Int?
  oldFeedback   String?
  newFeedback   String?
  reason        String
  status        GradeChangeStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())

  submission  Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("GradeChangeRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?      @relation("GradeChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([submissionId])
}

model Attendance {
  id         String           @id @default(cuid())
  courseId   String
  studentId  String
  date       DateTime
  status     AttendanceStatus @default(PRESENT)
  note       String?
  checkOutAt DateTime?

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, date])
  @@index([courseId, date])
  @@index([studentId, date])
}

model Quiz {
  id           String    @id @default(cuid())
  courseId     String
  title        String
  description  String?
  dueAt        DateTime?
  timeLimitMin Int?
  maxAttempts  Int       @default(1)
  isPublished  Boolean   @default(false)
  quizPassword String?
  ipSubnet     String?
  createdAt    DateTime  @default(now())

  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions  Question[]
  attempts   QuizAttempt[]
  secureExams SecureExam[]
}

model Question {
  id       String       @id @default(cuid())
  quizId   String
  text     String
  type     QuestionType @default(SINGLE)
  options  Json         @default("[]")
  correct  Json         @default("[]")
  points   Int          @default(1)
  position Int          @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id         String    @id @default(cuid())
  quizId     String
  studentId  String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  score      Int?
  answers    Json      @default("{}")

  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  secureExamRun SecureExamRun?

  @@index([studentId])
  @@index([quizId])
}

model ScheduleEntry {
  id         String           @id @default(cuid())
  groupId    String
  dayOfWeek  Int
  slot       Int
  subject    String
  subjectId  String?
  lessonType String?
  teacher    String?
  teacherId  String?
  room       String?
  parity     String?
  status     ScheduleStatus   @default(NORMAL)
  approval   ScheduleApproval @default(APPROVED)
  note       String?
  sectionId  String?
  /// Manba: `null` — qo'lda kiritilgan, `"edupage"` — avto sinxronlangan.
  source     String?
  /// Manba tizimidagi identifikator (karta:kun:guruh) — takroriy importni oldini oladi.
  externalId String?
  updatedAt  DateTime         @default(now()) @updatedAt

  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subjectRef Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherRef User?    @relation("ScheduleTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  sectionRef Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  subGroup String?

  @@unique([source, externalId])
  @@index([groupId, dayOfWeek])
  @@index([subjectId])
  @@index([teacherId])
  @@index([sectionId])
}

enum ScheduleStatus {
  NORMAL
  CHANGED
  MOVED
  CANCELLED
}

enum ScheduleApproval {
  PENDING
  APPROVED
}

enum GradeChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  REJECTED
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Announcement {
  id        String    @id @default(cuid())
  courseId  String?
  authorId  String
  title     String
  body      String
  audience  Json?
  createdAt DateTime  @default(now())

  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
}

model ForumTopic {
  id        String   @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  body      String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  course  Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author  User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies ForumReply[]

  @@index([courseId, createdAt])
}

model ForumReply {
  id        String   @id @default(cuid())
  topicId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  topic  ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([topicId, createdAt])
}

model Certificate {
  id         String   @id @default(cuid())
  courseId   String
  studentId  String
  issuedById String
  grade      Int?
  issuedAt   DateTime @default(now())

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student  User   @relation("CertificateStudent", fields: [studentId], references: [id], onDelete: Cascade)
  issuedBy User   @relation("CertificateIssuedBy", fields: [issuedById], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
}

/// O'qituvchining o'z fani doirasida talabaga qo'shimcha GPA balli.
///
/// `tenths` — ball ×10 butun ko'rinishi (0.6 → 6, 4.0 → 40). Kasr sonlarni
/// saqlashda yuvish xatosi bo'lmasligi uchun. Chegara: 6..40.
model BonusPoint {
  id          String   @id @default(cuid())
  courseId    String
  studentId   String
  awardedById String
  tenths      Int
  reason      String
  createdAt   DateTime @default(now())

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User   @relation("BonusPointStudent", fields: [studentId], references: [id], onDelete: Cascade)
  awardedBy User   @relation("BonusPointAwardedBy", fields: [awardedById], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, awardedById])
  @@index([studentId])
  @@index([courseId])
}

/// O'qituvchi ballari — o'qituvchi oquvchilarga beriladigan max 15 balllik chegirma.
model TeacherPoint {
  id          String   @id @default(cuid())
  courseId    String
  studentId   String
  awardedById String
  points      Float    // 0.1..15 ball
  category    String   // masalan: davomat, faollik, aloqadirilish va h.k.
  reason      String?
  createdAt   DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation("TeacherPointStudent", fields: [studentId], references: [id], onDelete: Cascade)
  awardedBy User @relation("TeacherPointAwardedBy", fields: [awardedById], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, awardedById, category])
  @@index([studentId])
  @@index([courseId])
}

/// Davomat balli — o'qituvchi har bir kurs/sinf uchun davomat ballini belgilaydi.
model AttendancePointConfig {
  id         String  @id @default(cuid())
  courseId   String
  groupId    String?
  points     Float   @default(1) // 0.1..15
  teacherId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group   Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseId, groupId])
  @@index([courseId])
  @@index([groupId])
}

/// Xodimning lavozimi.
///
/// BUXGALTER roli oylik bo'yicha birinchi bo'lib shu yerdan foydalanadi:
/// lavozimga bazaviy oylik (`baseSalary`) biriktiriladi, xodim esa
/// `User.staffPositionId` orqali bog'lanadi. Summa — butun so'm (`Int`).
model StaffPosition {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String?  @unique
  /// Bazaviy oylik, so'm.
  baseSalary   Int      @default(0)
  departmentId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  users      User[]

  @@index([departmentId])
}

/// Navbar turi (smena). Xodim haftaning bir kuni uchun bittagina
/// navbarga biriktiriladi. Vaqti daqiqada (`startMinutes`, 0..1439)
/// saqlanadi — masalan 08:00 → 480.
model Shift {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String?  @unique
  startMinutes Int
  endMinutes   Int
  isNight      Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments StaffShiftAssignment[]
}

/// Xodimning haftalik navbari: qaysi hafta kuni, qaysi navbardan.
model StaffShiftAssignment {
  id        String    @id @default(cuid())
  userId    String
  shiftId   String
  /// 0 = Yakshanba ... 6 = Shanba
  weekday   Int
  startsOn  DateTime  @default(now())
  endsOn    DateTime?
  createdAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([userId, weekday, startsOn])
  @@index([weekday])
  @@index([shiftId])
}

/// Bir xodimning bir oy uchun oylik yozuvi.
///
/// `total` maydoni saqlanadi (base + bonus − deduction), shuning uchun
/// hisobot o'qishda qayta hisoblash kerak bo'lmaydi. Barcha summalar
/// butun so'm.
model SalaryRecord {
  id           String       @id @default(cuid())
  userId       String
  /// Oy boshi (JS `Date` doim UTC 00:00). UNIQUE shu qiymat bo'yicha.
  month        DateTime
  baseAmount   Int          @default(0)
  bonusAmount  Int          @default(0)
  /// `base + bonus`. Usaqlar (deduction) moduli yo'q — kerak bo'lsa
  /// keyin alohida qo'shiladi.
  total        Int          @default(0)
  status       SalaryStatus @default(DRAFT)
  note         String?
  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user       User  @relation("SalaryRecordUser", fields: [userId], references: [id], onDelete: Cascade)
