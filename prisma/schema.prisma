  DRAFT
  PENDING
  APPROVED
  PAID
}

enum ScheduleApproval {
  PENDING
  APPROVED
}

enum ScheduleStatus {
  NORMAL
  CHANGED
  MOVED
  CANCELLED
}

enum SecureExamLimitAction {
  WARN
  TERMINATE
}

enum SecureExamRunStatus {
  ACTIVE
  SUBMITTED
  TERMINATED
}

enum SecureExamStatus {
  SCHEDULED
  ACTIVE
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  LATE
}

enum WorkTaskStatus {
  OPEN
  DONE
}
