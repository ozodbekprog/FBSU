model SecureExam {
  id                String                @id @default(cuid())
  quizId            String
  courseId          String
  createdById       String
  title             String
  code              String                @unique
  startsAt          DateTime
  endsAt            DateTime
  durationMin       Int?
  requireFullscreen Boolean               @default(true)
  blockCopy         Boolean               @default(true)
  requireClient     Boolean               @default(false)
  webcamEnabled     Boolean               @default(false)
  maxWarnings       Int                   @default(3)
  limitAction       SecureExamLimitAction @default(TERMINATE)
  status            SecureExamStatus      @default(SCHEDULED)
  createdAt         DateTime              @default(now())

  quiz      Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User   @relation("SecureExamCreator", fields: [createdById], references: [id], onDelete: Cascade)
  runs      SecureExamRun[]

  @@index([courseId, startsAt])
  @@index([status, startsAt])
}

model SecureExamRun {
  id            String              @id @default(cuid())
