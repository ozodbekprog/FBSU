model Conversation {
  id             String   @id @default(cuid())
  participantAId String
  participantBId String
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  /// "Ikkalasida o'chirish" — yozuvlar bazadan o'chmaydi, balki yashiriladi
  /// (audit izi va shikoyat tekshiruvi saqlanib qoladi).
  clearedForEveryoneAt DateTime?

  participantA User          @relation("ConversationA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB User          @relation("ConversationB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages     Message[]
  calls        CallSession[]
  settings     ConversationSetting[]

  @@unique([participantAId, participantBId])
  @@index([lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  type           MessageType @default(TEXT)
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  /// Forward qilingan asl xabar. `null` bo'lsa — xabar o'z xabari.
  forwardedFromId String?
  forwardedAt     DateTime?

  /// Javob berilgan asl xabar (reply). `null` — oddiy xabar.
  replyToId String?
  replyTo   Message? @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReply")
  /// Tahrirlangan vaqt (null — tahrirlanmagan).
  editedAt   DateTime?
  /// "O'chirilgan" — yozuv bazada qoladi (audit), lekin ko'rinmaydi.
  deletedAt  DateTime?

  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments   MessageAttachment[]
  forwardedFrom Message?     @relation("MessageForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwardedTo   Message[]   @relation("MessageForward")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([forwardedFromId])
  @@index([replyToId])
}

/// Xabar turi — matn, ovozli yozuv yoki fayl.
enum MessageType {
  TEXT
  VOICE
  FILE
}

enum AttachmentKind {
  VOICE
  IMAGE
  FILE
}

/// Xabarga ilova.
///
/// Ovoz va fayl PostgreSQL `bytea` ustunida saqlanadi: Vercel serverless
/// funksiyalarining diski vaqtinchalik — fayl `body` ustuni esa
/// fayl bilan bir xarakterda saqlanadi. Baza 12 MB dan boshlanadi;
/// 1 daqiqalik Opus ovoz ≈ 180 KB, limit 5 MB (≈ 28 daqiqa).
model MessageAttachment {
  id        String         @id @default(cuid())
  messageId String
  kind      AttachmentKind
  mimeType  String
  /// Mazmun — `bytea`
  bytes     Bytes
  size      Int
  /// Ovoz uchun davomiylik (soniya)
  durationSec Int?
  /// Asl fayl nomi
  fileName  String?
  createdAt DateTime       @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

/// Telegram uslubidagi suhbat sozlamalari — foydalanuvchi bo'yicha.
/// `Conversation` da emas, chunki har bir tomonda boshqa qaror bo'lishi
/// mumkin: bir tomon mahkamlagan, ikkinchisi arxivlagan bo'lishi mumkin.
model ConversationSetting {
  conversationId String
  userId         String
  pinnedAt       DateTime?
  archivedAt     DateTime?
  /// `null` — ovozsiz emas; o'tgan vaqt — muddati tugagan.
  mutedUntil     DateTime?
  /// "Tarixni tozalash" — shu vaqtdan keyingi xabarlar ko'rinmaydi
  /// (yozuvlar bazada saqlanib qoladi).
  clearedAt      DateTime?
  /// "Suhbatni o'chirish" — Telegram uslubi: suhbat FAQAT shu
  /// foydalanuvchi ro'yxatidan yashiriladi. Yozuvlar va qarshi tomon
  /// uchun hech narsa o'zgarmaydi.
  ///
  /// Yashirin hisoblanadi faqat `deletedAt > lastMessageAt` bo'lganda —
  /// ya'ni o'chirilgandan KEYIN yangi xabar kelmagan bo'lsa. Qarshi
  /// tomon yozsa, suhbat o'z-o'zidan ro'yxatga qaytadi (Telegram'dagi
  /// kabi) — buning uchun alohida kod kerak emas.
  deletedAt      DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, archivedAt])
  @@index([userId, deletedAt])
}

/// Bloklash — ikki tomonlama: yozish yuborilmaydi, suhbat yopiladi.
model ChatBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("ChatBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("ChatBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// Foydalanuvchini shikoyat qilish (Telegram'dagi "Shikoyat qilish").
model UserReport {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
  reason     String
  note       String?
  createdAt  DateTime @default(now())

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportReported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId])
}

/// Video qo'ng'iroq holati.
///
/// `RINGING` — chaqirilgan, hali javob yo'q.
/// `ACTIVE`   — ikkala tomon ham ulandi (media P2P, server orqali o'tmaydi).
/// `ENDED` / `DECLINED` / `MISSED` — tugagan.
enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  DECLINED
  MISSED
}

/// Qo'ng'iroq turi — ovozli yoki video.
enum CallMedia {
  AUDIO
  VIDEO
}

/// WebRTC signal turi. Media oqimi P2P; server faqat bu signallarni
/// almashtiradi (polling orqali — Vercel serverless WebSocket serverini
/// qo'llab-quvvatlamaydi).
enum CallSignalType {
  OFFER
  ANSWER
  ICE
  HANGUP
}

model CallSession {
  id             String     @id @default(cuid())
  conversationId String
  callerId       String
  calleeId       String
  status         CallStatus @default(RINGING)
  media          CallMedia  @default(VIDEO)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime   @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller       User         @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee       User         @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  signals      CallSignal[]

  @@index([calleeId, status])
  @@index([callerId, status])
  @@index([status, createdAt])
}

model CallSignal {
  id        String         @id @default(cuid())
  callId    String
  fromId    String
  type      CallSignalType
  payload   Json?
  createdAt DateTime       @default(now())

  call CallSession @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, createdAt])
}

model BugReport {
