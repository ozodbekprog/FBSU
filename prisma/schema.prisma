  fullscreen    Boolean             @default(false)
  webcam        Boolean             @default(false)
  extraMin      Int                 @default(0)
  lastSeenAt    DateTime            @default(now())
  startedAt     DateTime            @default(now())
  finishedAt    DateTime?

  exam    SecureExam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  student User            @relation("SecureExamStudent", fields: [studentId], references: [id], onDelete: Cascade)
  attempt   QuizAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  events    SecureExamEvent[]
  snapshots SecureExamSnapshot[]

  @@unique([examId, studentId])
  @@index([examId, status])
}

