enum EnrollmentStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum GradeChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaterialType {
  TEXT
  FILE
  VIDEO
  LINK
}

enum MessageType {
  TEXT
  VOICE
  FILE
}

enum OralDefenseResult {
  PASSED
  FAILED
}

enum OralDefenseStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  DONE
  CANCELLED
}

enum ParentRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum PublicationIndexing {
  NONE
  SCOPUS
  WOS
  RINC
  LOCAL
}

enum PublicationKind {
  ARTICLE
  CONFERENCE
  MONOGRAPH
  PATENT
  TEXTBOOK
}

enum PublicationStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TEXT
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  REGISTRAR
  REKTOR
  DEKAN
  KAFEDRA_MUDIRI
  TYUTOR
  PRO_RECTOR
  XODIM
  OTA_ONA
  BUXGALTER
  NAZORATCHI
}

